# Groq (LLM for match analysis + RAG chat)
GROQ_API_KEY=
# Optional extra keys, comma-separated; requests rotate across all keys (more rate-limit headroom)
GROQ_API_KEYS=
# Hugging Face (embeddings, BAAI/bge-large-en-v1.5, 1024 dims)
HF_API_KEY=
# Pinecone (index: 1024 dims, cosine)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=resume-screening

# PostgreSQL. Dev: `npm run dev:db` starts a local PGlite Postgres on 5433.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true&sslmode=disable"

# Auth
JWT_SECRET=change-me-to-a-long-random-string
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Razorpay (https://dashboard.razorpay.com/app/keys). Empty in dev = simulated checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Email (SMTP). Until SMTP_HOST, SMTP_USER and SMTP_PASS are all set, emails are printed to the server log instead of sent.
# Gmail: smtp.gmail.com / 587 / your address / a 16-char App Password (Google Account > Security > App passwords)
# Brevo: smtp-relay.brevo.com / 587 · Resend: smtp.resend.com / 465, user "resend", pass = API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Resumint <no-reply@yourdomain.com>"

# Behind a proxy/load balancer (Render, Railway, Nginx): set to 1 so rate limits see the real client IP.
TRUST_PROXY=
# Set to 1 only for automated tests; disables all rate limits.
RATE_LIMIT_DISABLED=
